<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_widget_root"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1C1C1C"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/calendar_widget_header"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/calendar_widget_title"
            android:text="YANTA Calendar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button android:id="@+id/btn_widget_month" android:text="Month" android:textSize="11sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="36dp"/>
        <Button android:id="@+id/btn_widget_week" android:text="Week" android:textSize="11sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="36dp"/>
        <Button android:id="@+id/btn_widget_day" android:text="Day" android:textSize="11sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="36dp"/>
        <Button android:id="@+id/btn_widget_list" android:text="List" android:textSize="11sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="36dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/calendar_widget_empty"
        android:text="No upcoming events"
        android:textColor="#9A9794"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ListView
        android:id="@+id/calendar_widget_list"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>