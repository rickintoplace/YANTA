<?xml version="1.0" encoding="utf-8"?>
<!-- Event row of the day and agenda views: time gutter, colour bar, text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="@dimen/widget_row_time_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/widget_row_gap">

        <TextView
            android:id="@+id/row_time_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:maxLines="1"
            android:textSize="@dimen/widget_row_meta_size" />

        <TextView
            android:id="@+id/row_time_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textSize="@dimen/widget_row_meta_size"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_bar"
        android:layout_width="@dimen/widget_row_bar_width"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/widget_row_gap"
        android:paddingEnd="0dp">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textSize="@dimen/widget_row_title_size" />

        <TextView
            android:id="@+id/row_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/widget_row_meta_size"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
