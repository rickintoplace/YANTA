<?xml version="1.0" encoding="utf-8"?>
<!--
  The body of one span bar. Shared by all seven width variants so the bar's
  anatomy lives in a single place; only the enclosing weight differs.

  Doubles as the lane's spacer: with the background and title hidden it is
  simply empty width.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/span_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="1dp"
    android:layout_marginEnd="1dp">

    <ImageView
        android:id="@+id/span_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_rounded_sm" />

    <!-- Clipped mid-word for the same reason as the day chips: a bar that
         spans five columns should spend all of them on the title. -->
    <TextView
        android:id="@+id/span_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="none"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingTop="1dp"
        android:paddingEnd="3dp"
        android:paddingBottom="1dp"
        android:singleLine="true"
        android:textSize="@dimen/widget_chip_title_compact_size"
        tools:ignore="Deprecated" />
</FrameLayout>
