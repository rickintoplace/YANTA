<?xml version="1.0" encoding="utf-8"?>
<!-- One day column of the week view: weekday label, date marker, chips. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/column_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="1dp"
    android:paddingEnd="1dp">

    <TextView
        android:id="@+id/column_weekday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="@dimen/widget_weekday_size" />

    <FrameLayout
        android:layout_width="@dimen/widget_day_marker"
        android:layout_height="@dimen/widget_day_marker"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/column_marker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_shape_circle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/column_day_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="@dimen/widget_day_number_size" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/column_events"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
