<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">sans</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#141414</item>
        <item name="android:navigationBarColor">#141414</item>

        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#141414</item>

        <item name="android:colorAccent">#6EA8FE</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Yanta.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/yanta_logo_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_yanta_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>